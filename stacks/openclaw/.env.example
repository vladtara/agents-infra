# Pin a version tag; moving tags (latest, main) are rebuilt weekly.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.8

# Gateway auth token. Generated by init.py; keep it secret.
OPENCLAW_GATEWAY_TOKEN=

# Model provider keys, set at least one. Other providers (GEMINI_API_KEY,
# OPENROUTER_API_KEY, ...) can be added here; every key is passed to the container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

OPENCLAW_TZ=UTC

# Host address the gateway listens on. Keep loopback; reach it through Tailscale Serve or an SSH tunnel.
BIND_IP=127.0.0.1
