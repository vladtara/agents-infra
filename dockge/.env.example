# Image tag. ":1" tracks the stable 1.x release; "nightly" has newer features (PUID/PGID support).
DOCKGE_IMAGE=louislam/dockge:1

# Absolute path of this repo's stacks/ folder. Written by init.py.
STACKS_DIR=

# Owner of stack files Dockge creates. Written by init.py (honoured by images newer than 1.5.0).
PUID=
PGID=

# Host address the UI listens on. Keep loopback; the tailscale component serves it on the tailnet.
BIND_IP=127.0.0.1

TZ=UTC
